
def is_safe(arr,x,y,n):
    for row in range(n):
        if arr[row][y]==1:
            return False
        
    row = x
    col = y
    
    while row>=0 and col>=0:
        if arr[row][col] == 1:
            return False
        row-=1
        col-=1
        
    row = x
    col = y
    
    while row>=0 and col<n:
        if arr[row][col] ==1:
            return False
        row -=1
        col += 1
    return True
       
             

def nqueen(arr,row,n):
    if row>= n:
        return True
    
    for col in range(n):
        if is_safe(arr,row,col,n):
            arr[row][col] =1
            if nqueen(arr,row+1,n):
                return True
            arr[row][col] = 0
    return False
            
        
    
