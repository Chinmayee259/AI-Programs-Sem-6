public class Fibonacci {
    public static void printFibonacci(Integer n){
        Integer a = 0;
        Integer b = 1;
        
        System.debug(a);
        System.debug(b);
        
        for (Integer i = 2; i<n; i++){
            Integer c = a + b;
            System.debug(c);
            
            a = b;
            b = c;
        }
    }
}




TO RUN :- Fibonacci.printFibonacci(10);